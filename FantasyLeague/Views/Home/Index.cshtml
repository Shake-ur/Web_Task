@foreach (var article in Model.News)
{
    <article class="news-card">
        <img src="@article.ImageUrl"
             alt="@article.Title"
             class="news-image">

        <div class="news-content">
            <span class="news-source">
                @article.SourceName
            </span>

            <h3 class="news-title">
                @article.Title
            </h3>

            <p class="news-description">
                @article.Description
            </p>

            <div class="news-meta">
                <span>
                    @article.PublishedAt.ToString("dd.MM.yyyy HH:mm")
                </span>

                <a href="@article.Url"
                   target="_blank"
                   class="news-read-more">
                    Read more →
                </a>
            </div>
        </div>
    </article>
}



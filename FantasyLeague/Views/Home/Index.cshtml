@model FantasyLeague.ViewModels.IndexViewModel;
<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Work in Progress, will be landing Page in the Future.</a>.</p>
</div>

<div id="matches" class="empty">Loading...</div>
<script>
    async function loadLive(){
        const tempMatches = document.getElementById('matches');
        try{
            const result = await fetch('/api/lolesports/live');
            const events = await result.json();
                if(!events.length || events.length == 0){
                    tempMatches.textContent = 'No live matches at the moment.';
                    return;
                }
           tempMatches.className='';
               tempMatches.innerHTML = events.map(event => {
        const teams = event.match?.teams ?? [];
        const [team1, team2] = teams;

        const teamHtml = t => `
            <div class="team">
                ${t?.image ? `<img src="${t.image}" alt="${t.code ?? ''}">` : ''}
                <span>${t?.code ?? t?.name ?? '?'} (${t?.result?.gameWins ?? 0})</span>
            </div>`;

        return `
            <div class="match">
                <div>
                    <div class="league">
                        ${event.league?.name ?? ''} — ${event.blockName ?? ''}
                    </div>

                    ${teamHtml(team1)} vs ${teamHtml(team2)}
                </div>

                <div class="state">
                    ${event.state}
                </div>
            </div>`;
    }).join('');
    //tempMatches.innerHTML = events.map(event => `<div>${event.Name}</div>`).join('');
        } catch (error) {
            console.error('Error fetching live events:', error);
            tempMatches.innerHTML = 'Error loading matches.';
        }
    }
    loadLive();
    setInterval(loadLive, 30000);
</script>
